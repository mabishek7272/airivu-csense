# Copy to .env and fill in. Run scripts/generate_dev_secrets.sh first to create
# infra/secrets/* (JWT keypair, DB/Mongo/Redis/MinIO passwords) then this file.
# .env is git-ignored — never commit real secrets.

ENVIRONMENT=local

# --- PostgreSQL (system of record) ---
# Two distinct identities on purpose (SCH §15 "Tenant DB role cannot bypass RLS"):
#   POSTGRES_USER      superuser/owner — migrations and DDL ONLY.
#   POSTGRES_API_USER  NOSUPERUSER NOBYPASSRLS — what the APIs connect as, so that
#                      row-level security is actually enforced. A superuser would
#                      silently bypass every tenant-isolation policy in the schema.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=csense
POSTGRES_USER=csense_app
POSTGRES_PASSWORD=changeme_run_generate_script
POSTGRES_API_USER=csense_api
POSTGRES_API_PASSWORD=changeme_run_generate_script
# Admin API's role: same restrictions, but a member of the `csense_platform` group role,
# which the RLS policies require for cross-tenant reads. Tenant API's role is not.
POSTGRES_PLATFORM_API_USER=csense_platform_api
POSTGRES_PLATFORM_API_PASSWORD=changeme_run_generate_script

# --- Redis (sessions/cache/streams/locks) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_run_generate_script

# --- MinIO (object storage) ---
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=csense_minio
MINIO_ROOT_PASSWORD=changeme_run_generate_script
MINIO_USE_TLS=false

# --- JWT (asymmetric; keys generated by scripts/generate_dev_secrets.sh) ---
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_ISSUER=csense-local
JWT_ACCESS_TOKEN_TTL_SECONDS=600
JWT_REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Password hashing (Argon2id baseline per TRD-SEC) ---
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KB=65536
ARGON2_PARALLELISM=2

# --- Notification adapters (Phase 5/6; providers unconfirmed, see CLARIFICATIONS.md) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@csense.local

# --- CORS / origins ---
CUSTOMER_CRM_ORIGIN=http://localhost:5173
DEVELOPER_CONSOLE_ORIGIN=http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO
