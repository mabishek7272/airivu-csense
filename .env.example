# Copy to .env and fill in. Run scripts/generate_dev_secrets.sh first to create
# infra/secrets/* (JWT keypair, DB/Mongo/Redis/MinIO passwords) then this file.
# .env is git-ignored — never commit real secrets.

ENVIRONMENT=local

# --- PostgreSQL (system of record) ---
# Two distinct identities on purpose (SCH §15 "Tenant DB role cannot bypass RLS"):
#   POSTGRES_USER      superuser/owner — migrations and DDL ONLY.
#   POSTGRES_API_USER  NOSUPERUSER NOBYPASSRLS — what the APIs connect as, so that
#                      row-level security is actually enforced. A superuser would
#                      silently bypass every tenant-isolation policy in the schema.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=csense
POSTGRES_USER=csense_app
POSTGRES_PASSWORD=changeme_run_generate_script
POSTGRES_API_USER=csense_api
POSTGRES_API_PASSWORD=changeme_run_generate_script
# Admin API's role: same restrictions, but a member of the `csense_platform` group role,
# which the RLS policies require for cross-tenant reads. Tenant API's role is not.
POSTGRES_PLATFORM_API_USER=csense_platform_api
POSTGRES_PLATFORM_API_PASSWORD=changeme_run_generate_script

# --- Redis (sessions/cache/streams/locks) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_run_generate_script

# --- MinIO (object storage) ---
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=csense_minio
MINIO_ROOT_PASSWORD=changeme_run_generate_script
MINIO_USE_TLS=false
# Host a BROWSER can reach, used only for presigned URLs (not the container name).
# In production, this is the `storage.` Traefik router (infra/traefik/dynamic.prod.yml)
# - e.g. storage.yourdomain.com. Left at localhost:9000, every presigned/public URL
# this platform generates (evidence snapshots, exports, white-label branding
# logos/favicons) is broken in production even though everything else works.
MINIO_PUBLIC_ENDPOINT=localhost:9000
# Independent of MINIO_USE_TLS above - that governs the *internal* minio:9000
# connection (almost always plain HTTP, even in production), this governs the
# *public* endpoint's scheme (almost always TLS in production, terminated by Traefik).
# Unset (the default) falls back to MINIO_USE_TLS, which is wrong in the common case
# where the two differ - set this explicitly whenever they do. A real deploy hit
# `SSL: WRONG_VERSION_NUMBER` from exactly this before it was split (CHECKLIST.md's
# 2026-09-11 production-deploy entry).
MINIO_PUBLIC_USE_TLS=false

# --- JWT (asymmetric; keys generated by scripts/generate_dev_secrets.sh) ---
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_ISSUER=csense-local
JWT_ACCESS_TOKEN_TTL_SECONDS=600
JWT_REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Password hashing (Argon2id baseline per TRD-SEC) ---
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KB=65536
ARGON2_PARALLELISM=2

# --- Notification adapters (Phase 5/6; providers unconfirmed, see CLARIFICATIONS.md) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@csense.local

# --- CORS / origins ---
CUSTOMER_CRM_ORIGIN=http://app.localhost:8080,http://localhost:5173
DEVELOPER_CONSOLE_ORIGIN=http://console.localhost:8080,http://localhost:3000

# --- Public demo site ---
# Optional. When both are set, the public demo site (frontend/demo-site) shows a "log in
# to the live demo" section with these credentials in plain sight - they are meant to be
# public, so this should be a dedicated low-privilege tenant with only sample data, never
# a real customer's account. Leave both unset to ship the demo site without that section.
LIVE_DEMO_EMAIL=
LIVE_DEMO_PASSWORD=

# --- Logging ---
LOG_LEVEL=INFO

# --- Notification providers ---
# Resend: outbound email. Cloudflare hosts SPF/DKIM/DMARC for the sending domain and
# Email Routing forwards replies to the inbound webhook (reply-to-acknowledge).
RESEND_API_KEY=
RESEND_FROM_ADDRESS=alerts@yourdomain.com
RESEND_REPLY_TO=reply@yourdomain.com

# WhatsApp gateway (edge/whatsapp-gateway). Generate with: openssl rand -hex 24
# This key can send messages as your linked WhatsApp number - treat it as a credential.
WHATSAPP_GATEWAY_URL=http://whatsapp-gateway:8080
WHATSAPP_GATEWAY_API_KEY=
WHATSAPP_INSTANCE=default

# --- Outbound address guard (camera probing, WireGuard provisioning) ---
# The specific ranges THIS deployment's own networking already reaches - Docker bridges,
# a directly-attached host LAN. Not "all of RFC1918": that would reject every legitimate
# site LAN a tenant could ever tunnel in, since 10.x/192.168.x are exactly the address
# spaces the WireGuard deployment guide expects a camera-side LAN to use. Set to the
# actual bridge/LAN ranges this host uses; the default is Docker's own default bridge plus
# this project's Compose-created one.
RESERVED_LOCAL_NETWORKS=172.17.0.0/16,172.18.0.0/16

# --- WireGuard tunnel provisioning (Edge > Tunnel) ---
# The pool a device's /32 tunnel address is allocated from - see
# backend/shared/csense_shared/security/vpn_pool.py. 65k+ addresses, so collisions are not
# something day-to-day operation runs into; only change this if it collides with a
# reserved network above.
WIREGUARD_POOL_CIDR=10.8.0.0/16
# The platform's own WireGuard server identity - what a generated client config points
# at. Blank in local dev, where no real WireGuard server runs; a rendered client config
# says so rather than emitting a plausible-looking placeholder.
WIREGUARD_SERVER_PUBLIC_KEY=
WIREGUARD_SERVER_ENDPOINT=
WIREGUARD_SERVER_ADDRESS=
