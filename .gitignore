# Real, uncurated customer footage staged for scripts/build_demo_assets.py. This is
# meant to live outside the repo entirely (a sibling of this directory) - these entries
# are a safety net in case a scratch folder like this ever ends up created in here by
# mistake, not an endorsement of the location. Only the finished, reviewed, redacted
# output in frontend/demo-site/public/showcase/ is meant to reach git.
/curate-review/
/smoke-test/
/smoke-test-out/

# scripts/dast_baseline.py's own output - point-in-time scan artifacts, not source.
/reports/
