# Expo SDK 57 pins react to an exact 19.2.3, but expo/expo-router's own transitive tree
# (@expo/ui, expo-router's own react-dom-for-web dependency, etc.) peer-requires
# react-dom@^19.3.0, which in turn peer-requires react@^19.3.0 - a real, upstream
# version mismatch, not something this app's own dependencies caused. `npm install`
# tolerates it with a warning; `npm ci` (what EAS's remote build servers run) fails hard
# unless told to relax peer resolution. Setting it here - not just running
# `npm install --legacy-peer-deps` by hand - is what makes a clean `npm ci` succeed
# deterministically everywhere: local machines, CI, and EAS Build alike.
legacy-peer-deps=true
