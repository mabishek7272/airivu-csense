{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal" },
    "apti-preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "apti" }
    },
    "eaigleye-preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "eaigleye" }
    },
    "3rdi-preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "3rdi" }
    },
    "csense-preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "csense" }
    },
    "production": { "autoIncrement": true, "env": { "APP_VARIANT": "csense" } }
  },
  "submit": { "production": {} }
}
